{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mount ide",
  "version": "0.2.1",
  "identifier": "github.opie.mount",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mount",
        "maximized": true,
        "decorations":false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/mount.icns",
      "icons/mount.ico",
      "icons/mount.png"
    ]
  }
}
